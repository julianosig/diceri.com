# Copy to .env (gitignored) and fill in. Never commit real values.

# API server
DICERI_BIND_ADDRESS=127.0.0.1:8090
DICERI_ALLOWED_ORIGINS=http://localhost:5180
DICERI_LOG_FORMAT=pretty

# LiveKit Cloud project (Settings → API keys). All three or none.
DICERI_LIVEKIT_URL=wss://your-project.livekit.cloud
DICERI_LIVEKIT_API_KEY=
DICERI_LIVEKIT_API_SECRET=

# Media agent control API (apps/media-agent). Unset disables translation.
DICERI_AGENT_URL=http://127.0.0.1:8095
DICERI_AGENT_KEY=
# Where the agent listens (it reads the same file).
DICERI_AGENT_BIND_ADDRESS=127.0.0.1:8095
# Optional: comma-separated ElevenLabs voice ids (defaults to four stock voices).
# DICERI_TTS_VOICES=

# Soniox (speech-to-text). Not used by the code yet.
DICERI_SONIOX_API_KEY=

# Gemini (machine translation).
DICERI_GEMINI_API_KEY=

# ElevenLabs (text-to-speech).
DICERI_ELEVENLABS_API_KEY=
