# Copy to .env (gitignored) and fill in. Never commit real values.

# API server
DICERI_BIND_ADDRESS=127.0.0.1:8090
DICERI_ALLOWED_ORIGINS=http://localhost:5180
DICERI_LOG_FORMAT=pretty
# Production: serve the built SPA from the API (one origin).
# DICERI_WEB_DIR=apps/web/build
# Per-client POST limit (0 disables) and the real-IP header behind Cloudflare.
# DICERI_WRITE_LIMIT_PER_MINUTE=60
# DICERI_CLIENT_IP_HEADER=cf-connecting-ip
# Voice clones are named diceri-<deployment>-…; each agent only sweeps its own.
# DICERI_DEPLOYMENT=dev
# Accounts database (SQLite) and HTTPS-only session cookies (true in production).
# DICERI_DATABASE_URL=sqlite://diceri.db
# DICERI_SECURE_COOKIES=false

# LiveKit Cloud project (Settings → API keys). All three or none.
DICERI_LIVEKIT_URL=wss://your-project.livekit.cloud
DICERI_LIVEKIT_API_KEY=
DICERI_LIVEKIT_API_SECRET=

# Media agent control API (apps/media-agent). Unset disables translation.
DICERI_AGENT_URL=http://127.0.0.1:8095
DICERI_AGENT_KEY=
# Where the agent listens (it reads the same file).
DICERI_AGENT_BIND_ADDRESS=127.0.0.1:8095

# Speech-to-text provider for the media agent: scribe (default) or soniox.
# DICERI_STT_PROVIDER=scribe

# Voice cloning and speech: elevenlabs (default) or inworld (ADR 0016). The API and the
# media agent read the same file and must agree.
# DICERI_TTS_PROVIDER=elevenlabs
# DICERI_INWORLD_API_KEY=

# Soniox (speech-to-text): the media agent when DICERI_STT_PROVIDER=soniox, and the API,
# which checks a voice recording holds words before cloning it (no key: no voice recording).
DICERI_SONIOX_API_KEY=

# Gemini (machine translation).
DICERI_GEMINI_API_KEY=

# Room usernames per network: a long random secret (openssl rand -base64 32). Unset in
# development and tests, where every sign-up comes from the same machine.
# DICERI_NETWORK_KEY=
# DICERI_ACCOUNTS_PER_NETWORK=5
# Public beta: at most this many accounts (unset: open sign-up).
# DICERI_MAX_ACCOUNTS=100

# Plan limits and shared capacity (defaults shown; see apps/api/AGENTS.md).
# DICERI_FREE_CALL_MINUTES=60
# DICERI_FREE_DAILY_MINUTES=60
# DICERI_FREE_MONTHLY_MINUTES=60
# DICERI_PRO_MONTHLY_MINUTES=300
# DICERI_PRO_PRICE_CENTS=2900
# DICERI_TEAM_MONTHLY_MINUTES=800
# DICERI_TEAM_PRICE_CENTS=7900
# DICERI_MAX_LIVE_CALLS=15
# DICERI_MONTHLY_CALL_MINUTES=1500

# Recording your own voice for translations, and whether joining requires it (ADR 0014).
# DICERI_VOICE_CLONING=true
# DICERI_VOICE_REQUIRED=true
# Encrypts each account's kept voice recording (ADR 0015): openssl rand -base64 32.
# DICERI_VOICE_KEY=

# ElevenLabs (text-to-speech, Scribe speech-to-text, voice cloning).
DICERI_ELEVENLABS_API_KEY=
