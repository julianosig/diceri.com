[Unit]
Description=Diceri media agent (live translation)
After=network-online.target

[Service]
EnvironmentFile=%h/.config/diceri/production.env
WorkingDirectory=%h/.local/share/diceri/current
ExecStart=%h/.local/share/diceri/current/diceri-media-agent
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
