# Production settings layered on top of the provider keys from .env.example.
# Lives at ~/.config/diceri/production.env (mode 600); never commit the real file.
DICERI_DEPLOYMENT=prod
DICERI_BIND_ADDRESS=127.0.0.1:8100
DICERI_ALLOWED_ORIGINS=https://diceri.com
DICERI_LOG_FORMAT=json
# Relative to the release directory (the services' working directory).
DICERI_WEB_DIR=web
DICERI_CLIENT_IP_HEADER=cf-connecting-ip
DICERI_WRITE_LIMIT_PER_MINUTE=60
DICERI_AGENT_URL=http://127.0.0.1:8105
DICERI_AGENT_BIND_ADDRESS=127.0.0.1:8105
# Accounts survive deploys: keep the database outside the release directories.
DICERI_DATABASE_URL=sqlite:///home/USER/.local/share/diceri/diceri.db
DICERI_SECURE_COOKIES=true
