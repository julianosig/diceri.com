{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"extends": ["config:recommended"],
	"minimumReleaseAge": "3 days",
	"semanticCommits": "enabled",
	"semanticCommitScope": "deps",
	"packageRules": [
		{
			"groupName": "svelte ecosystem",
			"matchPackageNames": ["svelte", "@sveltejs/**", "svelte-check", "vite", "vitest", "@vitest/**"]
		},
		{ "groupName": "tailwind", "matchPackageNames": ["tailwindcss", "@tailwindcss/**", "tailwind-*"] },
		{ "groupName": "rust crates", "matchManagers": ["cargo"] },
		{ "matchUpdateTypes": ["patch"], "automerge": true }
	]
}
